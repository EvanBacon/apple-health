+  /**
+   Finds the best matching class ID for a SharedObject by checking its runtime type
+   and walking up the inheritance chain until a registered class is found.
+   This enables polymorphic return types where a function returns a base class
+   but the actual objects are subclass instances with their own Class definitions.
+   */
+  private static func findBestClassId(for sharedObject: SharedObject, in appContext: AppContext) -> ObjectIdentifier {
+    var currentType: AnyClass? = type(of: sharedObject)
+
+    // Walk up the class hierarchy to find a registered class definition
+    while let classType = currentType {
+      let classId = ObjectIdentifier(classType)
+
+      // Check if this class has a registered JavaScript class
+      if appContext.classRegistry.getJavaScriptClass(nativeClassId: classId) != nil {
+        return classId
+      }
+
+      // Move to the superclass
+      currentType = classType.superclass()
+    }
+
+    // Fallback to the declared type if no specific class was found
+    return ObjectIdentifier(type(of: sharedObject))
+  }
